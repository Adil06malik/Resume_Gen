# Application
APP_NAME="AI Resume Tailor"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite+aiosqlite:///./app.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/resume_tailor

# AI Provider
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-v1-3201b7251f833467cf5802b16a991af33f177da164b187eed71536fe1c355d02ps://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-super:free
# Alternative providers:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4-turbo-preview
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-3-5-sonnet-20241022
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=local-model

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60